# Runtime profile. Use production outside a private development machine.
APP_ENV=development

# Supabase Postgres connection. Use the Transaction pooler URL for the API.
# Replace the password locally; never commit it.
DATABASE_URL=postgresql+asyncpg://postgres.tewlwaxxpilaqpscojhu:DB_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://tewlwaxxpilaqpscojhu.supabase.co
SUPABASE_PROJECT_REF=tewlwaxxpilaqpscojhu
DB_CONNECT_TIMEOUT_SECONDS=5

# Only for the one-time migration utility; remove/clear after migration.
# MONGO_URL=mongodb://127.0.0.1:27017

# Frontend/API URLs
APP_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
READINESS_TIMEOUT_SECONDS=2

# Private admin account. Keep the password only in your password manager;
# ADMIN_PASSWORD_HASH is a PBKDF2 hash and is safe to store in this local env file.
ADMIN_EMAIL=admin@foodalertitalia.local
ADMIN_PASSWORD_HASH=pbkdf2_sha256$310000$REPLACE_SALT$REPLACE_DIGEST
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_SESSION_TTL_SECONDS=28800

# The API never starts the scheduler. Run `python scheduler.py` as one worker.
SCHEDULER_ENABLED=true
MINISTERO_CHROME_CHANNEL=chrome
MINISTERO_OCR_ENABLED=true
MINISTERO_OCR_DPI=300
# MINISTERO_OCR_LANG_PATH=  # defaults to the bundled Italian model
# PDFTOPPM_PATH=            # optional, if pdftoppm is not on PATH
SYNC_MINISTERO_MINUTES=30
SYNC_RASFF_MINUTES=360
SYNC_FAO_MINUTES=10080
SYNC_ENVIRONMENT_MINUTES=1440

# Destructive demo cleanup is disabled unless explicitly enabled in dev/test.
ALLOW_DESTRUCTIVE_SEED=false

# Optional official integration settings. Do not put secrets in source control.
# MINISTERO_PLAYWRIGHT_MODULE=playwright
# PLAYWRIGHT_BROWSERS_PATH=
# Copernicus Marine Toolbox (official account; both values are required).
# COPERNICUSMARINE_SERVICE_USERNAME=
# COPERNICUSMARINE_SERVICE_PASSWORD=
# COPERNICUS_TEMPERATURE_DATASET=cmems_mod_med_phy-tem_anfc_4.2km_P1D-m
# COPERNICUS_SALINITY_DATASET=cmems_mod_med_phy-sal_anfc_4.2km_P1D-m
# EMODnet public ERDDAP endpoint (no API key required).
# EMODNET_ERDDAP_URL=https://erddap.emodnet-chemistry.eu/erddap
# ISPRA public SPARQL endpoint (no API key required).
# ISPRA_API_URL=https://dati.isprambiente.it/sparql
